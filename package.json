{
  "name": "oh-my-oma",
  "version": "4.1.1",
  "description": "Multi-agent skill pack and workflow orchestration for Google Antigravity",
  "license": "MIT",
  "bin": {
    "oma": "bin/oma.js",
    "oh-my-oma": "bin/oma.js"
  },
  "files": [
    ".agent",
    ".governance",
    "bin",
    "src",
    "scripts",
    "templates",
    "schemas",
    "prompts",
    "commands",
    "docs",
    "install.sh",
    "install_global.sh",
    "README.md",
    "README_CN.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "node bin/oma.js setup",
    "setup:user": "node bin/oma.js setup --scope user",
    "setup:workspace": "node bin/oma.js setup --scope project-local",
    "doctor": "node bin/oma.js doctor",
    "catalog:generate": "node scripts/generate-catalog-docs.js",
    "catalog:skill-index": "node scripts/generate-skill-index.js",
    "governance:skills": "bash scripts/check-skill-governance.sh",
    "harness:lint": "node bin/oma.js harness lint",
    "source:skills:sync": "bash scripts/sync-upstream-skills.sh --source all",
    "test": "node tests/unit-tests.js && npm run governance:skills && npm run catalog:generate && npm run catalog:skill-index && node bin/oma.js doctor",
    "pack:dry-run": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "keywords": [
    "antigravity",
    "gemini",
    "ai-agent",
    "workflow",
    "skills",
    "orchestration"
  ]
}
